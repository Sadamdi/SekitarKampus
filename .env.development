# --- Dev server (Create React App) ---
# Jika port 3000 sudah dipakai, CRA akan menunggu konfirmasi di terminal;
# di Cursor/terminal tertama prompt itu kadang tidak kelihatan = "stuck".
# Pakai port dev lain agar tidak ada prompt tersembunyi:
PORT=3001

# Jangan buka browser otomatis (lebih cepat & mengurangi hang di Windows)
BROWSER=none

# Kompilasi dev lebih cepat (tanpa ESLint di webpack)
DISABLE_ESLINT_PLUGIN=true

# Opsional: bind ke loopback saja (kadang lebih stabil dari 0.0.0.0)
HOST=127.0.0.1
